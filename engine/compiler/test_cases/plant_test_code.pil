def END_GROWTH_RATE = 0.05
def PI = 3.14159

// Some cool colors
def BROWN = #D27F2DFF
def PINK  = #FF_00_FF_FF

@(entrypoint, state)
def main(cell):
    if cell.growth_rate <= END_GROWTH_RATE:
        return
    end

    if $Rand <= 0.33:
        $Spawn(0, :main)
        cell.state = :stem
    else:
        cell.state = :node if $Rand > .95 else :petal
    end
end

@state
def node(cell):
    TAU = 2 * PI
    turn_angle = TAU / 9

    if $Rand > 0.88:
        $Spawn(turn_angle, :main)
    end

    if $Rand > 0.77:
        $Spawn(-turn_angle, :main)
    end

    cell.state = :stem
end

@state
def stem(cell):
    cell.color = Colors.BROWN
    cell.length = cell.length + 0.001
    cell.thickness = cell.thickness + 0.005
end

@(terminal, state)
def petal(cell):
    cell.color = Colors.PINK
end
